{
  "expo": {
    "name": "ATEEM",
    "slug": "ateem-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F1E8",
    "android": {
      "package": "com.ateem.store",
      "versionCode": 1,
      "backgroundColor": "#F5F1E8",
      "googleServicesFile": "./google-services.json",
      "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS"]
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج ATEEM الوصول لميكروفونك عشان يسمعك في الشات.",
        "NSSpeechRecognitionUsageDescription": "يحتاج ATEEM يحوّل كلامك لنص داخل الشات."
      }
    },
    "plugins": [
  "./plugins/withImmersiveMode.js",
  ...
    ]
    "extra": {
      "eas": {}
    }
  }
}
