{
  "expo": {
    "name": "ATEEM",
    "slug": "ateem-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F1E8",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#F5F1E8",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
  "hidden": false,
  "translucent": false,
  "backgroundColor": "#F5EFE6",
  "barStyle": "dark-content"
    },
 
    "android": {
      "package": "com.ateem.store",
      "versionCode": 1,
      "backgroundColor": "#F5F1E8",
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F1E8"
      }
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج ATEEM الوصول لميكروفونك عشان يسمعك في الشات.",
        "NSSpeechRecognitionUsageDescription": "يحول كلامك لنص داخل الشات."
      }
    },
    "plugins": ["./plugins/withImmersiveMode.js"],
    "extra": {
      "eas": {}
    }
  }
}
